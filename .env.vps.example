# ============================================================
# 東京VPS 本番 .env テンプレート
#   使い方: cp .env.vps.example .env して値を埋める（.env はGit管理外）
#   docker-compose.prod.yml がこの .env を読み込む
# ============================================================

APP_NAME=Atally
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate で生成（または既存のRenderのAPP_KEYをそのまま流用）
APP_KEY=
APP_URL=https://atally.jp
APP_TIMEZONE=Asia/Tokyo

# Caddy がHTTPSを張るドメイン（DNSをこのVPSへ向ける）
DOMAIN=atally.jp

# ---- Database（compose内 db サービス）----
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=atally
DB_USERNAME=atally
# 強いパスワードを設定（compose の db もこの値を使う）
DB_PASSWORD=

# ---- Redis（compose内 redis サービス）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

LOG_CHANNEL=stderr
LOG_LEVEL=warning
FILESYSTEM_DISK=local

SANCTUM_TOKEN_EXPIRATION=43200

# ---- ハローワーク求人API（移行後、VPSのIPを申請・登録すること）----
HELLOWORK_BASE_URL=
HELLOWORK_ID=
HELLOWORK_PASS=

# ---- Stripe ----
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://atally.jp/auth/google/callback
GOOGLE_GA4_ID=
GOOGLE_SITE_VERIFICATION=

# ---- Mail ----
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@atally.jp
MAIL_FROM_NAME=Atally

# ---- X(Twitter) 連携（任意）----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- Crisp（任意）----
CRISP_WEBSITE_ID=
