# ============================================================
# Stage 1: フロントエンドビルド
# ============================================================
FROM node:20-alpine AS frontend

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --prefer-offline

COPY resources/ ./resources/
COPY vite.config.js ./
COPY public/ ./public/

# production ビルド
RUN npm run build

# ============================================================
# Stage 2: PHP 依存インストール
# ============================================================
FROM composer:2 AS composer

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --optimize-autoloader \
    --no-scripts

# ============================================================
# Stage 3: 本番ランタイム（Nginx + PHP-FPM）
# ============================================================
# GitHub Actions がビルド済みのベースイメージを使う（Render のビルド時間短縮）
ARG BASE_IMAGE=php:8.3-fpm-alpine
FROM ${BASE_IMAGE}

# PHP 設定
RUN printf 'upload_max_filesize = 20M\npost_max_size = 25M\nmemory_limit = 256M\n' \
    > /usr/local/etc/php/conf.d/uploads.ini

# OPcache 本番設定（コンパイル済みバイトコードをメモリにキャッシュ → リクエストごとのPHPコンパイルを排除）
RUN printf '\
opcache.enable=1\n\
opcache.memory_consumption=64\n\
opcache.interned_strings_buffer=8\n\
opcache.max_accelerated_files=10000\n\
opcache.revalidate_freq=0\n\
opcache.validate_timestamps=0\n\
opcache.save_comments=1\n\
opcache.enable_cli=0\n\
' > /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www/html

# アプリコードをコピー
COPY . .

# ビルド済みアセット & vendor を注入
COPY --from=frontend /app/public/build ./public/build
COPY --from=composer /app/vendor ./vendor

# ストレージ・キャッシュディレクトリの権限設定
RUN mkdir -p storage/logs storage/framework/cache storage/framework/sessions \
        storage/framework/views storage/app/public bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache \
    && mkdir -p /var/lib/nginx/tmp/client_body /tmp/nginx/client_body \
    && chown -R www-data:www-data /var/lib/nginx/tmp /tmp/nginx \
    && chmod -R 775 /var/lib/nginx/tmp /tmp/nginx

# Nginx 設定
COPY docker/nginx.conf /etc/nginx/nginx.conf

# PHP-FPM プール設定（ワーカー数・タイムアウト）
COPY docker/php-fpm.conf /usr/local/etc/php-fpm.d/zz-app.conf

# Supervisor 設定（PHP-FPM + Nginx + Queue worker + Scheduler）
RUN mkdir -p /etc/supervisor/conf.d /var/log/supervisor
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# 本番用エントリポイント
COPY docker/entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80

CMD ["entrypoint.sh"]
