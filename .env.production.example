# ============================================================
# Atally 本番環境 .env テンプレート
# このファイルを .env にコピーして各値を埋めてください
# cp .env.production.example .env
# ============================================================

APP_NAME=Atally
APP_ENV=production
APP_KEY=          # php artisan key:generate --show で生成した値を貼る
APP_DEBUG=false   # 必ず false に！
APP_TIMEZONE=Asia/Tokyo
APP_URL=https://your-domain.com   # 実際のドメインに変更

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ===== データベース =====
DB_CONNECTION=pgsql
DB_HOST=db        # Docker使用時はそのまま / Render等managed DBは接続文字列から取得
DB_PORT=5432
DB_DATABASE=atally
DB_USERNAME=atally
DB_PASSWORD=      # 32文字以上のランダムな文字列を設定

# ===== Redis =====
REDIS_HOST=redis  # Docker使用時はそのまま / Render等は接続URLから取得
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== キャッシュ / セッション / キュー =====
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ===== メール =====
# Amazon SES の例:
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-northeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=    # SES SMTP ユーザー名
MAIL_PASSWORD=    # SES SMTP パスワード
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="Atally"

# ===== Stripe 決済（本番キー） =====
# https://dashboard.stripe.com/apikeys から取得
# 本番キーは pk_live_... / sk_live_... で始まる
STRIPE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxx
# Webhook シークレット: Stripe ダッシュボード > Webhooks > エンドポイント詳細から取得
# エンドポイント URL: https://your-domain.com/api/webhook/stripe
# 購読イベント: payment_intent.payment_failed, invoice.payment_failed,
#              invoice.paid, invoice.payment_action_required, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ===== Google OAuth =====
# https://console.cloud.google.com から取得
# 承認済みリダイレクト URI に https://your-domain.com/auth/google/callback を追加
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

# ===== CORS / Sanctum =====
SANCTUM_STATEFUL_DOMAINS=your-domain.com,www.your-domain.com
SANCTUM_TOKEN_EXPIRATION=43200

# ===== Crisp チャット（任意） =====
# https://app.crisp.chat から取得
CRISP_WEBSITE_ID=

VITE_APP_NAME="${APP_NAME}"
