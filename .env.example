APP_NAME=Atally

# ===== 環境設定 =====
# 本番環境では必ず以下を設定:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_KEY= (php artisan key:generate で生成 — 本番デプロイ前に必ず再生成)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8000

# ===== ログ =====
LOG_CHANNEL=stack
# 本番: warning 推奨（debug だとパフォーマンス低下＋情報漏洩リスク）
LOG_LEVEL=warning

# ===== データベース =====
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=atally
DB_USERNAME=atally
# 本番: 32文字以上のランダムなパスワードを設定
DB_PASSWORD=

# ===== キャッシュ / セッション / キュー =====
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ===== Redis =====
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== メール =====
# 本番: smtp に変更し、実際のSMTP情報を設定
#   例: Amazon SES, SendGrid, Mailgun 等
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@atally.io"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Stripe 決済 =====
# Stripe ダッシュボードから取得（本番キーを使用）
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ===== Google OAuth =====
# Google Cloud Console から取得
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="${APP_URL}/auth/google/callback"

# ===== Google Analytics 4 =====
# Google Analytics の測定ID (GA4) → 例: G-XXXXXXXXXX
GOOGLE_GA4_ID=

# ===== Google Search Console =====
# Search Console > 設定 > 所有権確認 > HTMLタグ の content= の値
GOOGLE_SITE_VERIFICATION=

# ===== X（旧Twitter）自動投稿 =====
# developer.twitter.com でアプリを作成し、OAuth 1.0a の認証情報を取得
# 設定するとハローワーク同期後・毎朝10時に新着求人が自動投稿される
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ===== Sentry エラー監視 =====
# sentry.io でプロジェクト作成後、DSNを取得して設定
SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN=

# ===== CORS =====
# 本番: 許可するオリジンをカンマ区切りで指定
# CORS_ALLOWED_ORIGINS=https://atally.io,https://www.atally.io

# ===== Sanctum =====
# 本番: ステートフルドメイン
# SANCTUM_STATEFUL_DOMAINS=atally.io,www.atally.io
# トークン有効期限（分）: デフォルト30日
SANCTUM_TOKEN_EXPIRATION=43200

VITE_APP_NAME="${APP_NAME}"

# ===== ハローワーク API =====
# 厚生労働省 提供求人API（申請して取得）
# トークンは当日のみ有効。メンテナンス: 毎日 0:00-6:00、月末 21:30-6:00
HELLOWORK_BASE_URL=
HELLOWORK_ID=
HELLOWORK_PASS=
